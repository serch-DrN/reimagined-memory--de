{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "camino-neurocirugia-privado",
  "main": "hosting/worker.js",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
